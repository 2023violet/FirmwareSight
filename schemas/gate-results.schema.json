{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firmwaresight:schema:gate-results:1",
  "title": "FirmwareSight Gate Results v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "snapshot_id",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule_id",
          "state",
          "effective_severity",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "state": {
            "enum": [
              "PASS",
              "REVIEW",
              "BLOCK",
              "UNKNOWN",
              "N/A"
            ]
          },
          "effective_severity": {
            "enum": [
              "PASS",
              "REVIEW",
              "BLOCK"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remediation": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
