{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firmwaresight:schema:accepted-reviews:1",
  "title": "FirmwareSight Accepted Reviews v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "acceptances"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "actor",
          "accepted_at",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "original_state": {
            "enum": [
              "REVIEW"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
