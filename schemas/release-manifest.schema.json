{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firmwaresight:schema:release-manifest:1",
  "title": "FirmwareSight Release Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_by",
    "release",
    "build",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_by": {
      "type": "object",
      "required": [
        "product",
        "version"
      ],
      "properties": {
        "product": {
          "const": "FirmwareSight"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": [
        "snapshot_id"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "git_dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
